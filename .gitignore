# --- dependencies & tooling (never commit these) ---
node_modules/
# project is Bun-only; bun.lock is the one true lockfile
package-lock.json
# local Vercel CLI project link
.vercel/
.DS_Store
Thumbs.db

# --- deploy build artifact ---
# public/ is GENERATED by tools/build-public.mjs on every build (vercel.json
# pins outputDirectory=public, which overrides the Vercel dashboard setting).
# It must never be committed.
public/

# --- editors / logs ---
*.log
.idea/
.vscode/
.history/

# NOTE on purposeful NON-ignores:
#  * css/site.css  -> the committed Tailwind build, so the site works even
#    without running `bun run build:css` (Vercel rebuilds it anyway).
#  * bun.lock      -> commit it, but keep it at "lockfileVersion": 1
#    (written by Bun 1.3.x). Bun >= 1.4 rewrites it to version 2, which the
#    Bun 1.3.x bundled into Vercel's install step cannot read.

# --- private font binaries (keep purchased faces OUT of the public repo) ---
# The site runs entirely on the committed OFL woff2 faces in vendor/fonts/
# (g8321-700, lilita-one-400, m-plus-rounded-1c-700/800). Locally dropped
# .ttf/.otf files (e.g. a purchased FOT-Yuruka Std backup) must never be
# pushed to a public repo. See vendor/fonts/README.md.
vendor/fonts/*.ttf
vendor/fonts/*.otf
